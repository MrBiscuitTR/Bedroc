# =============================================================================
# Bedroc — Environment Variables
# Copy this file to .env and fill in all values before running docker compose.
#
# NEVER commit .env to git. It is in .gitignore.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────

# Bind address when running the server WITHOUT Docker (Docker sets 0.0.0.0
# inside the container and restricts exposure through its port mapping).
HOST=127.0.0.1

# Internal port Fastify listens on (not exposed publicly; nginx proxies to it)
PORT=3000

NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Uses the Docker Compose service name 'postgres' as the host.
# PASSWORD must match POSTGRES_PASSWORD below.
DATABASE_URL=postgres://bedroc_app:CHANGE_THIS_DB_PASSWORD@postgres:5432/bedroc

# PostgreSQL superuser password (used by the postgres container on first boot)
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters. Use different secrets for access and refresh.
JWT_ACCESS_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32_DIFFERENT

# Token lifetimes. Access token is short-lived (auto-refreshed silently via cookie).
# Refresh token controls how long a session lasts before re-login is required.
# Supported suffixes: m (minutes), h (hours), d (days)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── CORS (REQUIRED) ───────────────────────────────────────────────────────────
# Exact frontend origins allowed to use this backend, comma-separated.
# The server refuses to start if this is empty or contains "*": allowing every
# origin together with the login cookie would let any website take over a
# logged-in user's session.
#
# Include every place you open Bedroc from:
#   https://bedroc.cagancalidag.com   the public hosted frontend
#   https://notes.example.com         your own domain (docker-compose.yml serves the UI too)
#   https://10.66.66.1                if you browse to the server by IP
#   http://localhost:*                the desktop app (any local port; localhost only)
#   http://localhost:5173             frontend dev server
CORS_ORIGIN=https://bedroc.cagancalidag.com,http://localhost:*

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the server, used to find the real
# client IP for rate limiting. 1 = nginx (docker-compose.yml) or Caddy
# (docker-compose.public.yml). Use 2 if Cloudflare (or another CDN) sits in
# front of Caddy/nginx. Use 0 if the server is exposed directly.
# Never "true": that lets clients spoof their IP and bypass rate limits.
TRUST_PROXY=1

# ── Registration ──────────────────────────────────────────────────────────────
# Set to false once you've created your account(s) to stop strangers signing
# up on your server. Existing users keep working.
ALLOW_REGISTRATION=true

# ── Access log (public VPS only) ──────────────────────────────────────────────
# When true, writes one line per successful login/register to logs/access.log:
#   [timestamp] login    username         ip-address
#
# Enable this on a public-facing server if you want an audit trail.
# Leave unset or false for WireGuard/private deployments — no value there.
# docker-compose.public.yml sets this to "true" automatically.
ENABLE_ACCESS_LOG=false
