# Auto detect text files and perform LF normalization
* text=auto

# Files executed or parsed inside Linux containers MUST keep LF line endings,
# even on Windows checkouts with core.autocrlf=true. A CRLF init.sh makes the
# postgres container fail with "/bin/bash^M: bad interpreter".
*.sh            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.env.example    text eol=lf
Makefile        text eol=lf
