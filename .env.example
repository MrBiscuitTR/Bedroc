# =============================================================================
# Bedroc — environment template
#
# Easiest: run `bash bedroc.sh setup`. It creates the env file for you with
# freshly generated secrets and permissions 600.
#
# Manual: copy this file to .env.public (public VPS stack) or .env (WireGuard /
# private stack), replace every CHANGE_THIS value, then `chmod 600` the file.
# Generate secrets with:  openssl rand -hex 32
#
# Env files are git-ignored. Back yours up somewhere safe: without these
# secrets a restored database cannot be used.
# =============================================================================

# Which stack this file is for: public (docker-compose.public.yml, API only,
# behind your own reverse proxy) or wireguard (docker-compose.yml, frontend +
# API + TLS on a private address). If omitted: .env.public → public, .env → wireguard.
# BEDROC_MODE=public

# Compose project name. It selects your data volume (<project>_postgres_data),
# so never change it on a running installation. Defaults: bedroc-public for
# public mode; the directory name (lowercased) for wireguard mode.
# BEDROC_PROJECT=bedroc-public

# ── Database ──────────────────────────────────────────────────────────────────
# Superuser password: used only for first-time setup and as a migration
# fallback. The API server never receives it.
POSTGRES_PASSWORD=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Least-privilege application user. Use a DIFFERENT password from the one above.
# Keep host "postgres", port 5432 and database "bedroc".
# Note: both passwords are fixed when the database is first created; editing
# them here later does not change them inside an existing database.
DATABASE_URL=postgres://bedroc_app:CHANGE_THIS_SECOND_RANDOM_HEX@postgres:5432/bedroc

# ── Redis ─────────────────────────────────────────────────────────────────────
# Letters and digits only (it is embedded in a URL). Redis holds only
# short-lived login challenges, in memory.
REDIS_PASSWORD=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32

# ── Token signing keys ────────────────────────────────────────────────────────
# At least 32 characters each and different from each other. Changing them
# logs everyone out.
JWT_ACCESS_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_THIS_GENERATE_WITH_OPENSSL_RAND_HEX_32_DIFFERENT

# Access tokens are short-lived (renewed silently); the refresh lifetime is
# how long a device stays logged in. Suffixes: m, h, d.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── CORS (REQUIRED) ───────────────────────────────────────────────────────────
# Exact frontend origins allowed to use this backend, comma-separated.
# The server refuses to start if this is empty or contains "*": allowing every
# origin together with the login cookie would let any website take over a
# logged-in user's session.
#
# Include every place you open Bedroc from:
#   https://bedroc.cagancalidag.com   the public hosted frontend
#   https://notes.example.com         your own domain
#   https://10.66.66.1                wireguard stack: the address you browse to (add :port if not 443)
#   http://localhost:*                the desktop app (any local port; localhost only)
#   http://localhost:5173             frontend dev server
CORS_ORIGIN=https://bedroc.cagancalidag.com,http://localhost:*

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Number of reverse proxies in front of the server, used to find the real
# client IP for rate limiting. 1 = Caddy/nginx (both stacks). 2 = Cloudflare
# in front of Caddy, with Caddy's trusted_proxies set (see VPS-DEPLOY.md).
# 0 = exposed directly. Never "true": that lets clients spoof their IP.
TRUST_PROXY=1

# ── Accounts & privacy ────────────────────────────────────────────────────────
# Set to false once your account(s) exist, so strangers can't sign up.
ALLOW_REGISTRATION=true

# Store the client IP with each login session (shown in Settings → Sessions so
# users can spot logins they don't recognise). false = never stored.
RECORD_LOGIN_IP=true

# Public stack only: append "timestamp event username IP" for every login and
# registration to ./logs/access.log. Off by default (privacy).
ENABLE_ACCESS_LOG=false

# ── Public stack (docker-compose.public.yml) ─────────────────────────────────
# Localhost port the API listens on; your reverse proxy forwards to it.
BEDROC_PORT=3000
# Adminer DB GUI (only while `bash bedroc.sh admin start` is running)
# ADMINER_PORT=8081

# ── WireGuard stack (docker-compose.yml) ─────────────────────────────────────
# The ONLY address nginx listens on (your WireGuard/Tailscale/LAN IP).
# BIND_IP=10.66.66.1
# HTTP_PORT=80
# HTTPS_PORT=443
# ADMINER_PORT=8080

# ── Running the server without Docker (development) ──────────────────────────
# HOST=127.0.0.1
# PORT=3000
# REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379
